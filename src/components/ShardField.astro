---
/**
 * The home page: a field of crystal shards — one per entry in the registry
 * plus unlabelled fillers — painted on a canvas over the persisted nebula,
 * with a cursor light on a second canvas above it. Labels are real links
 * with exact polygon hit areas (clip-path), positioned by the script in
 * src/scripts/shard-field.ts, which also runs the once-per-session intro
 * and the click → expand → navigate transition.
 *
 * `data-state` is "intro" while the crystallisation plays, "settled" at rest
 * and "expanding" between a click and the navigation. `.is-live` is added by
 * the script once labels may animate, so a return visit never fades them in.
 */
import { shards } from "../data/shards";
const quote =
  "“Humans are not reward-maximizers, they are value shard-executors.”";
---

<main class="field" data-state="intro">
  <canvas class="field-canvas" aria-hidden="true"></canvas>
  <svg class="field-minerals" aria-hidden="true" focusable="false"></svg>
  <svg class="field-gleam" aria-hidden="true" focusable="false"></svg>
  <canvas class="field-light" aria-hidden="true"></canvas>
  <nav class="field-shards" aria-label="Shards">
    {shards.map((shard) => (
      <a class="shard" href={`/${shard.id}/`} data-shard={shard.id}>
        <span class="shard-label">{shard.label}</span>
      </a>
    ))}
  </nav>
  <div class="field-ghosts" aria-hidden="true"></div>
  <p class="field-hint label" aria-hidden="true">
    click to skip
  </p>
  <blockquote class="field-epigraph">
    <p>{quote}</p>
    <footer class="label">Quintin Pope and Alex Turner</footer>
  </blockquote>
</main>

<style>
  .field {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* The mobile quote reserves space below the resting field. Let the
     expanding canvas paint into that space without moving the shards. */
  .field[data-state="expanding"] {
    overflow: visible;
  }

  /* Two stacked canvases: the static field, and the cursor light above it
     so pointer movement never repaints the field. The light screens onto
     the field so it adds to the seams instead of covering them. */
  .field-canvas,
  .field-minerals,
  .field-gleam,
  .field-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .field-light {
    mix-blend-mode: screen;
  }

  .field-gleam {
    mix-blend-mode: screen;
  }
  .field-gleam :global(.gleam-edge) {
    animation: shard-gleam var(--gleam-duration) cubic-bezier(0.4, 0, 0.6, 1)
      both;
  }
  @keyframes shard-gleam {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 0.32;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .field-gleam {
      display: none;
    }
  }

  /* Cached grain shapes breathe slowly; the static canvas stays untouched. */
  .field-minerals {
    opacity: 0;
    visibility: hidden;
    mix-blend-mode: screen;
    transition: opacity 900ms ease;
  }

  .field[data-state="settled"] .field-minerals {
    opacity: 1;
    visibility: visible;
  }

  .field-minerals :global(.mineral-breath) {
    opacity: 0.06;
    animation: mineral-breathe var(--mineral-period) ease-in-out infinite;
    animation-delay: var(--mineral-delay);
    animation-play-state: paused;
  }

  .field[data-state="settled"] .field-minerals :global(.mineral-breath) {
    animation-play-state: running;
  }

  @keyframes mineral-breathe {
    0%,
    100% {
      opacity: 0.06;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-minerals {
      transition: none;
    }

    .field-minerals :global(.mineral-breath) {
      animation: none;
      opacity: 0.12;
    }
  }

  .field-shards {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shard {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    text-decoration: none;
    pointer-events: auto;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .shard:focus-visible {
    outline: none;
  }

  .shard-label {
    position: absolute;
    top: var(--cy, 50%);
    left: var(--cx, 50%);
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  .shard-label {
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(13px, 1.25vw + 6px, 20px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 0 18px var(--shard-mid);
  }

  .field[data-state="intro"] .shard-label {
    opacity: var(--growth-label, 0);
    transition: none;
  }

  .field[data-state="settled"] .shard-label {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  .field.is-live[data-state="settled"] .shard-label {
    transition: opacity 600ms var(--ease-out);
  }

  .shard:focus-visible .shard-label {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 8px;
  }

  /* Expanding: everything else fades at once; the chosen label lingers. */
  .field[data-state="expanding"] .shard:not(.is-active) .shard-label {
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }

  .field[data-state="expanding"] .shard.is-active .shard-label {
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 100ms linear 280ms;
  }

  /* Ghost text: possible goals slowly surface on the unlabelled
     filler crystals (src/data/ghosts.ts). Never interactive. The cursor
     light lifts them through --ghost-boost, scaling the colour's alpha.
     The spans are created at runtime, so they carry no scope attribute:
     their rules are :global under the scoped container. */
  .field-ghosts {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }

  .field-ghosts :global(.ghost) {
    position: absolute;
    top: var(--cy, 50%);
    left: var(--cx, 50%);
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    animation: ghost-goal-cycle var(--ghost-period, 14s) ease-in-out infinite;
    animation-delay: var(--ghost-delay, 0s);
    animation-play-state: paused;
  }

  .field-ghosts :global(.ghost-word) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(10px, 0.75vw + 5px, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1.2;
    color: rgba(230, 227, 239, calc(0.2 * var(--ghost-boost, 1)));
  }

  .field-ghosts :global(.ghost-phrase) {
    max-width: var(--ghost-max, 200px);
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(11px, 0.8vw + 6px, 14px);
    line-height: 1.3;
    text-wrap: balance;
    color: rgba(230, 227, 239, calc(0.24 * var(--ghost-boost, 1)));
  }

  .field[data-state="settled"] .field-ghosts {
    opacity: 1;
  }

  .field[data-state="settled"] :global(.ghost) {
    animation-play-state: running;
  }

  .field[data-ghosts-paused] :global(.ghost) {
    animation-name: none;
  }

  @keyframes ghost-goal-cycle {
    0%,
    2%,
    83%,
    100% {
      opacity: 0;
    }
    14%,
    62% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-ghosts :global(.ghost) {
      animation: none;
      opacity: 0.65;
    }

    .field-ghosts {
      transition: none;
    }
  }

  .field-hint {
    position: absolute;
    bottom: calc(6rem + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink-3);
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }

  /* Only while the intro is actually running (the head gate sets the class
     before first paint), and only after it has had a moment to breathe. */
  :global(html.intro-running) .field[data-state="intro"] .field-hint {
    opacity: 1;
    transition-delay: 900ms;
  }

  :global(html.intro-running) .field[data-state="intro"] .field-epigraph,
  .field[data-intro-animation] .field-epigraph {
    animation: quote-settle 5100ms cubic-bezier(0.45, 0, 0.55, 1) both;
  }

  @keyframes quote-settle {
    0% {
      opacity: 0;
      transform: translate(
          -50%,
          calc(
            -50svh + var(--quote-bottom, 1.5rem) +
              env(safe-area-inset-bottom, 0px) + 50%
          )
        )
        scale(var(--quote-intro-scale, 1.75));
    }
    7%,
    72% {
      opacity: 1;
      transform: translate(
          -50%,
          calc(
            -50svh + var(--quote-bottom, 1.5rem) +
              env(safe-area-inset-bottom, 0px) + 50%
          )
        )
        scale(var(--quote-intro-scale, 1.75));
    }
    100% {
      opacity: 0.85;
      transform: translate(-50%, 0) scale(1);
    }
  }

  /* The epigraph: shard theory in one line, faint at the foot of the field.
     It takes the hint's spot once the field has settled and hides again
     while a shard expands. Never interactive. */
  .field-epigraph {
    position: fixed;
    bottom: calc(
      var(--quote-bottom, 1.5rem) + env(safe-area-inset-bottom, 0px)
    );
    left: 50%;
    width: min(92vw, 44ch);
    margin: 0;
    padding: 0;
    transform: translate(-50%, 6px);
    text-align: center;
    text-wrap: balance;
    pointer-events: none;
    user-select: none;
    opacity: 0;
  }

  .field-epigraph p {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .field-epigraph footer {
    margin-top: var(--space-2);
    font-size: 0.625rem;
    color: var(--ink-3);
  }

  .field[data-state="intro"] .field-epigraph,
  .field[data-state="settled"] .field-epigraph {
    opacity: 0.85;
    transform: translate(-50%, 0);
  }

  .field.is-live .field-epigraph {
    transition: opacity 300ms var(--ease-out);
  }

  .field[data-state="expanding"] .field-epigraph {
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }

  /* On phones the quotation gets its own quiet footnote space. The field
     script measures this element, so the canvas and polygon links both
     stop above the quote instead of putting the last label behind it. */
  @media (max-width: 600px) and (min-height: 561px) {
    .field {
      --quote-bottom: 0.5rem;
      --quote-intro-scale: 1.2;
      bottom: calc(5rem + env(safe-area-inset-bottom, 0px));
    }

    .field-hint {
      bottom: var(--space-5);
    }

    .field-epigraph {
      position: fixed;
      bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));
      width: min(90vw, 44ch);
    }

    .field-epigraph p {
      font-size: 0.8125rem;
    }

    .field-epigraph footer {
      margin-top: 0.5rem;
      line-height: 1.5;
    }
  }

  @media (max-height: 560px) {
    .field-epigraph {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shard-label,
    :global(.ghost),
    .field-hint,
    .field-epigraph {
      transition: none;
    }
  }
  /* The head gate prevents a fallback flash during normal module startup.
     It expires if the module fails to load; no JavaScript means no gate. */
  :global(html[data-field-pending])
    .field:not([data-field-enhanced])
    .field-shards {
    visibility: hidden;
  }

  /* Real links are the default; enhance only after the field initializes. */
  .field:not([data-field-enhanced]) .field-shards {
    inset: 76px var(--gutter) 16px;
    display: grid;
    align-content: start;
    gap: 12px;
    overflow-y: auto;
    pointer-events: auto;
  }
  .field:not([data-field-enhanced]) .shard {
    position: relative;
    inset: auto;
    clip-path: none !important;
    padding: 18px 22px;
    border: 1px solid var(--shard-mid);
    border-radius: 4px;
    background: #0b0b18;
  }
  .field:not([data-field-enhanced]) .shard-label {
    position: static;
    display: block;
    opacity: 1;
    transform: none;
    white-space: normal;
    transition: none;
  }
  .field:not([data-field-enhanced]) .field-hint,
  .field:not([data-field-enhanced]) .field-epigraph {
    visibility: hidden;
  }
</style>

<script>
  import "../scripts/shard-field";
</script>
