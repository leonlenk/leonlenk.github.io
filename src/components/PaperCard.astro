---
/**
 * One academic paper as a single-column seam panel. Only the title is a
 * link (it leaves the site), so the panel itself stays a plain block.
 */
import type { CollectionEntry } from "astro:content";
import { paperShapes } from "../lib/card-shapes";
import { toClipPathPercent } from "../lib/geometry";
import SeamPanel from "./SeamPanel.astro";

interface Props {
  paper: CollectionEntry<"papers">;
  index: number;
  /**
   * Horizontal pads shared by every row in the list (see sharedPaperPadX),
   * so stacked rows keep one text column. Defaults to this row's own pads.
   */
  padX?: { wide: number; narrow: number };
}

const { paper, index, padX } = Astro.props;
const { id, title, authors, venue, year, url, type, highlight } = paper.data;

const typeLabel: Record<typeof type, string> = {
  journal: "Journal",
  conference: "Conference",
  preprint: "Preprint",
};

// A desktop and a phone silhouette from one seed (see paperShapes).
const { wide, narrow } = paperShapes(id);
const polygon = toClipPathPercent(wide.polygon);
const polygonNarrow = toClipPathPercent(narrow.polygon);
const padXWide = Math.max(wide.padX, padX?.wide ?? 0);
const padXNarrow = Math.max(narrow.padX, padX?.narrow ?? 0);
const pads = `--pad-x:${padXWide};--pad-y:${wide.padY};--pad-x-n:${padXNarrow};--pad-y-n:${narrow.padY}`;
---

<SeamPanel
  polygon={polygon}
  polygonNarrow={polygonNarrow}
  as="article"
  class="paper"
  style={pads}
  data-type={type}
  data-index={index}
>
  <div class="paper-body">
    <div class="paper-top">
      <span class="label paper-type">{typeLabel[type]}</span>
      <time class="label paper-year" datetime={String(year)}>
        {year}
      </time>
    </div>
    <h2 class="paper-title">
      <a href={url} target="_blank" rel="noopener noreferrer">
        {title}
        <svg
          class="ext"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3ZM5 5h6v2H7v10h10v-4h2v6H5V5Z"></path>
        </svg>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </h2>
    <ul class="authors" aria-label="Authors">
      {authors.map((author) => (
        <li class:list={{ "author-me": author === highlight }}>{author}</li>
      ))}
    </ul>
    <p class="venue">{venue}</p>
  </div>
</SeamPanel>

<style>
  .paper-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: max(clamp(18px, 4vw, 28px), calc(var(--pad-y) * 1%))
      max(clamp(20px, 5vw, 36px), calc(var(--pad-x) * 1%));
  }

  @media (max-width: 639.98px) {
    .paper-body {
      padding: max(18px, calc(var(--pad-y-n, var(--pad-y)) * 1%))
        max(20px, calc(var(--pad-x-n, var(--pad-x)) * 1%));
    }
  }

  .paper-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-1);
  }

  .paper-type {
    color: color-mix(in srgb, var(--shard-edge-0) 55%, var(--ink));
  }

  .paper-year {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .paper-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: 0;
    color: #fff;
    text-wrap: pretty;
  }

  .paper-title a {
    text-decoration: none;
    text-decoration-color: color-mix(
      in srgb,
      var(--shard-edge-0) 55%,
      var(--ink)
    );
    text-underline-offset: 0.18em;
  }

  .paper-title a:hover,
  .paper-title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .ext {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.3em;
    vertical-align: 0.05em;
    fill: var(--ink-muted);
    transition: fill 180ms var(--ease-out);
  }

  .paper-title a:hover .ext,
  .paper-title a:focus-visible .ext {
    fill: #fff;
  }

  .authors {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .authors li {
    display: inline;
  }

  .authors li + li::before {
    content: ", ";
  }

  .author-me {
    font-weight: 600;
    color: #fff;
  }

  .venue {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
