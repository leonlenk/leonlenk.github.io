---
import Base from "../layouts/Base.astro";
import ShardField from "../components/ShardField.astro";
---

<Base
  title="Leon Lenk"
  description="Writing, research, food, books, self, philosophy — one shard each."
>
  <Fragment slot="head">
    {/* Same gate as the field script, run before first paint so the chrome
        never flashes in ahead of the intro. */}
    <script is:inline>
      (function () {
        try {
          if (
            !sessionStorage.getItem("shardfield:intro-seen") &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            document.documentElement.classList.add("intro-running");
          }
        } catch {
          /* Storage blocked: no intro, no hidden chrome. */
        }
      })();
    </script>
  </Fragment>

  <h1 class="visually-hidden">Leon Lenk</h1>
  <ShardField />
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
