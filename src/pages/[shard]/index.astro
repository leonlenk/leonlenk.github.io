---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ReadingTools from "../../components/ReadingTools.astro";
import SeamPanel from "../../components/SeamPanel.astro";
import ShardCard from "../../components/ShardCard.astro";
import PaperCard from "../../components/PaperCard.astro";
import { shards } from "../../data/shards";
import { cardShape } from "../../lib/card-shapes";
import { hashString, mulberry32, toClipPathPercent } from "../../lib/geometry";
import { formatDate, isoDate, postHref } from "../../lib/posts";
import { postDescription, siteDescription } from "../../lib/sharing";
import "../../styles/prose.css";

export function getStaticPaths() {
  return shards.map((shard) => ({
    params: { shard: shard.id },
    props: { shard },
  }));
}

const { shard } = Astro.props;
const selfPost =
  shard.id === "self" ? await getEntry("posts", "self/about") : undefined;
if (shard.id === "self" && !selfPost) {
  throw new Error("Self requires src/content/posts/self/about.md");
}
const selfContent = selfPost ? await render(selfPost) : undefined;
const SelfContent = selfContent?.Content;
const title = selfPost?.data.title ?? shard.label;
const description = selfPost ? postDescription(selfPost) : siteDescription;

const posts = (
  await getCollection(
    "posts",
    ({ data }) => data.shard === shard.id && !data.draft,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Only the research shard carries the papers list.
const papers =
  shard.id === "research"
    ? (await getCollection("papers")).sort((a, b) => b.data.year - a.data.year)
    : [];

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const count = [
  ...(shard.id === "research" ? [plural(papers.length, "paper")] : []),
  plural(posts.length, "post"),
].join(" · ");

const empty = cardShape(mulberry32(hashString(`${shard.id}/empty`)), {
  aspect: 3,
  depth: 0.4,
});
const emptyPolygon = toClipPathPercent(empty.polygon);

// Leave room for a long section name without shrinking the shorter titles.
const h1Em = 1.08 * title.length;
---

<Base title={title} description={description} shard={shard.id}>
  <main
    class:list={["shard-page", { "self-page": shard.id === "self" }]}
    data-shard={shard.id}
  >
    <header class="shard-header">
      <div class="header-top">
        <a href="/" class="label back">
          ← Shards
        </a>
        {shard.id !== "self" && <span class="label count">{count}</span>}
      </div>
      <h1 style={`--h1-em:${h1Em}`}>{title}</h1>
      {selfPost && <p class="description">{description}</p>}
      {selfPost && (
        <div class="label meta">
          <time datetime={isoDate(selfPost.data.pubDate)}>
            {formatDate(selfPost.data.pubDate)}
          </time>
          {selfPost.data.updatedDate && (
            <span>
              · updated{" "}
              <time datetime={isoDate(selfPost.data.updatedDate)}>
                {formatDate(selfPost.data.updatedDate)}
              </time>
            </span>
          )}
          {selfPost.data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {selfPost.data.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          )}
        </div>
      )}
      <svg class="header-facet" viewBox="0 0 180 24" aria-hidden="true">
        <polyline points="0,23 138,23 178,1" />
      </svg>
    </header>

    {papers.length > 0 && (
      <section class="papers" aria-labelledby="papers-heading">
        <div class="section-head">
          <h2 class="label" id="papers-heading">
            Papers
          </h2>
          <span class="rule" aria-hidden="true" />
        </div>
        <ul class="paper-list">
          {papers.map((paper, i) => (
            <li>
              <PaperCard paper={paper} index={i} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {SelfContent ? (
      <article class="prose" aria-label={title}>
        <SelfContent />
      </article>
    ) : (
      <section class="posts" aria-labelledby="posts-heading">
        <div class="section-head">
          <h2 class="label" id="posts-heading">
            Posts
          </h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        {posts.length > 0 ? (
          <ul class="post-grid">
            {posts.map((post, i) => (
              <li>
                <ShardCard post={post} index={i} href={postHref(post)} />
              </li>
            ))}
          </ul>
        ) : (
          <SeamPanel
            polygon={emptyPolygon}
            class="empty"
            style={`--pad-x:${empty.padX};--pad-y:${empty.padY}`}
            quiet
          >
            <p>Nothing has crystallised here yet.</p>
          </SeamPanel>
        )}
      </section>
    )}
  </main>
  <ReadingTools />
</Base>

<style>
  /* Top padding = the fixed chrome bar (56px, 52px on phones) plus air. */
  .shard-page {
    max-width: 1120px;
    margin-inline: auto;
    padding: calc(56px + var(--space-6)) var(--gutter) var(--space-9);
  }

  .self-page {
    max-width: calc(68ch + 2 * var(--gutter));
  }

  /* --- header ---------------------------------------------------------- */

  .shard-header {
    padding-block: var(--space-4) var(--space-3);
    margin-bottom: var(--space-7);
  }

  .header-facet {
    width: 180px;
    height: 24px;
    margin-top: var(--space-5);
    overflow: visible;
    fill: none;
    stroke: var(--shard-edge-0);
    stroke-width: 1;
    opacity: 0.55;
  }

  .header-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .back {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .back:hover,
  .back:focus-visible {
    color: #fff;
  }

  .count {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .shard-header h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .description {
    max-width: 42ch;
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
    color: var(--ink-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- sections -------------------------------------------------------- */

  .papers {
    margin-bottom: var(--space-8);
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
    line-height: 1;
    color: var(--ink-2);
  }

  .rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--shard-edge-0),
      var(--shard-edge-1),
      transparent
    );
    opacity: 0.5;
  }

  .paper-list,
  .post-grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paper-list {
    display: grid;
    gap: var(--space-4);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-5);
  }

  .post-grid > li {
    display: grid;
  }

  .empty p {
    padding: max(clamp(28px, 6vw, 48px), calc(var(--pad-y) * 1%))
      max(clamp(28px, 6vw, 48px), calc(var(--pad-x) * 1%));
    font-family: var(--font-body);
    font-style: italic;
    text-align: center;
    color: var(--ink-muted);
  }

  @media (max-width: 639.98px) {
    .shard-page {
      padding-top: calc(52px + var(--space-5));
    }

    .shard-header {
      padding-top: var(--space-3);
    }

    .header-top {
      margin-bottom: var(--space-6);
    }

    .header-facet {
      width: 140px;
      height: auto;
    }

    .shard-header h1 {
      font-size: min(
        clamp(2rem, 11vw, 2.6rem),
        calc((100vw - 2 * var(--gutter)) / var(--h1-em))
      );
    }
  }
</style>
