---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getShard } from "../../data/shards";
import { formatDate, isoDate, postSlug, type Post } from "../../lib/posts";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { shard: post.data.shard, post: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const shard = getShard(post.data.shard);
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description} shard={post.data.shard}>
  <main class="post-page" data-shard={shard.id}>
    <article class="post">
      <header class="post-header">
        <a href={`/${shard.id}/`} class="label back" rel="up">
          ← {shard.label}
        </a>
        <h1>{title}</h1>
        <div class="label meta">
          <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
          {updatedDate && (
            <span class="updated">
              <span class="dot" aria-hidden="true">
                ·
              </span>
              updated{" "}
              <time datetime={isoDate(updatedDate)}>
                {formatDate(updatedDate)}
              </time>
            </span>
          )}
          {tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          )}
        </div>
      </header>

      <hr class="seam-rule" />

      <div class="prose">
        <Content />
      </div>

      <footer class="post-footer">
        <a href={`/${shard.id}/`} class="label">
          ← Back to {shard.label}
        </a>
        <span class="dot" aria-hidden="true">
          ·
        </span>
        <a href="/" class="label">
          All shards
        </a>
      </footer>
    </article>
  </main>
</Base>

<style>
  /* Top padding = the fixed chrome bar (56px, 52px on phones) plus air. */
  .post-page {
    padding: calc(56px + var(--space-6)) var(--gutter) var(--space-9);
  }

  .post {
    max-width: 68ch;
    margin-inline: auto;
  }

  /* --- header ---------------------------------------------------------- */

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .back {
    align-self: flex-start;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .back:hover,
  .back:focus-visible {
    color: #fff;
  }

  .post-header h1 {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    line-height: 1.12;
    letter-spacing: 0;
    color: #fff;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--ink-3);
  }

  .updated {
    display: inline-flex;
    gap: var(--space-3);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dot {
    color: var(--ink-3);
  }

  /* --- seam rule ------------------------------------------------------- */

  .seam-rule {
    height: 1px;
    margin: var(--space-6) 0;
    border: 0;
    background: linear-gradient(
      90deg,
      var(--shard-edge-0),
      var(--shard-edge-1)
    );
    box-shadow: 0 0 12px var(--shard-mid);
  }

  /* --- footer ---------------------------------------------------------- */

  .post-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .post-footer a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .post-footer a:hover,
  .post-footer a:focus-visible {
    color: #fff;
  }

  @media (max-width: 639.98px) {
    .post-page {
      padding-top: calc(52px + var(--space-5));
    }
  }
</style>
